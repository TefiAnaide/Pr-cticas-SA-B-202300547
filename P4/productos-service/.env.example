# Servidor
PORT=8000

# Base de datos (propia de este microservicio)
DB_HOST=postgres-productos
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=productos_db

# Debe coincidir con el JWT_SECRET del auth-service: los tokens
# se emiten en auth-service y se verifican aqui de forma local.
JWT_SECRET=changeme

# Microservicio de autorizacion (reutilizado de la Practica 2)
AUTHZ_SERVICE_URL=http://authz-service:4000
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=300
