# Servidor
PORT=8000

# Base de datos (propia de este microservicio)
DB_HOST=postgres-reportes
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reportes_db

# Debe coincidir con el JWT_SECRET del auth-service.
JWT_SECRET=changeme

# Microservicio de autorizacion (reutilizado de la Practica 2)
AUTHZ_SERVICE_URL=http://authz-service:4000
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=300

# Microservicio de productos, consumido para construir el reporte de inventario
PRODUCTOS_SERVICE_URL=http://productos-service:8000
