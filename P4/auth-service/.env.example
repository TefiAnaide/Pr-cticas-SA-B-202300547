# Servidor
PORT=3000

# Base de datos
DB_HOST=postgres-auth
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aut

# JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=15m
JWT_REFRESH_GRACE_SECONDS=300

# Cifrado de datos sensibles (AES-256) y hash determinístico para búsquedas (HMAC)
AES_SECRET_KEY=changeme_64_hex_chars_32_bytes
HMAC_SECRET_KEY=changeme_64_hex_chars_32_bytes

# Cookies
COOKIE_SECURE=false

# Microservicio de autorización
AUTHZ_SERVICE_URL=http://authz-service:4000
AUTHZ_MAX_RETRIES=3
AUTHZ_RETRY_BACKOFF_MS=300

# Admin inicial (bootstrap): se crea al arrancar si no existe.
SEED_ADMIN_EMAIL=admin@practica4.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_NOMBRE=Administrador
